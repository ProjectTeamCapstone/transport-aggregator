# Copy to .env and fill in. NEVER commit .env.
# Every value below has a working default or a documented fallback, so the
# stack starts and the demo runs even with no API keys at all.

# ---------------------------------------------------------------- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------ PostgreSQL ---
# The dev password is fine on a laptop and NOT fine on a server. Before any
# deployment:  openssl rand -hex 24
# Use hex, not a passphrase: postgres_dsn() builds the URL by f-string with no
# percent-encoding, so @ : / ? # % in a password corrupt the DSN.
# Only read when the container initialises an empty data directory - change it
# before the first `docker compose up`, or you also need ALTER USER.
# This is the only place it lives: the JDBC sink carries a {{POSTGRES_PASSWORD}}
# placeholder that stream/deploy_connectors.py fills at deploy time.
POSTGRES_USER=naijafares
POSTGRES_PASSWORD=naijafares_dev
POSTGRES_DB=naijafares
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# --------------------------------------------------------------- ksqlDB ----
KSQLDB_URL=http://localhost:8088

# ------------------------------------------------------- Carrier / fare APIs
# Sky Scrapper (RapidAPI free tier) - flight search data.
# Sign up: https://rapidapi.com/apiheya/api/sky-scrapper
RAPIDAPI_KEY=
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com

# Travelpayouts Aviasales Data API - historical/cheapest fare data.
# Sign up: https://www.travelpayouts.com/
TRAVELPAYOUTS_TOKEN=

# ------------------------------------------------------------- Booking -----
# Duffel SANDBOX token only. Must start with duffel_test_.
# A live token (duffel_live_) is rejected at startup - this project never
# touches real money.
DUFFEL_API_TOKEN=
DUFFEL_API_VERSION=v2

# Retry policy for the carrier call. Only failures that provably booked nothing
# are retried; a timeout is never retried, because it might have.
BOOKING_MAX_ATTEMPTS=3
BOOKING_BACKOFF_BASE_SECONDS=0.5
# Percent the live price may exceed the quoted price before we refuse to book.
BOOKING_PRICE_TOLERANCE_PCT=1.0

# ---------------------------------------------- Claude natural-language search
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ------------------------------------------------------ FX (GBP -> NGN) -----
# Used for the Lagos-London route. If the live source is unreachable the
# pinned fallback rate is used instead, so the demo never breaks on FX.
FX_API_URL=https://api.exchangerate.host/latest
FX_FALLBACK_GBP_NGN=2050.0
FX_CACHE_TTL_SECONDS=3600

# -------------------------------------------------------- Search cache -----
# Seconds the API holds a route's offers in memory before re-reading Redis.
# Does not affect staleness reporting: age is computed from each offer's own
# fetched_at, so a cached price still reports its true age. 0 disables it.
ROUTE_CACHE_TTL_SECONDS=5

# ----------------------------------------------------------- Simulator -----
# The price simulator is a first-class component, not a fallback hack.
SIMULATOR_SEED=608
SIMULATOR_TICK_SECONDS=300
