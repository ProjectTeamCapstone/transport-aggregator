# Secrets - never commit
.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ML
# mlruns holds every experiment run and grows without bound - not committed.
# ml/artifacts IS committed: the trained model is a named project deliverable
# and the LightGBM text format is small and diffable.
mlruns/
mlartifacts/
*.pkl
*.joblib

# Node / React
node_modules/
ui/build/
ui/dist/

# R
.Rproj.user/
.Rhistory

# Data dumps
data/raw/
data/interim/
*.db

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

